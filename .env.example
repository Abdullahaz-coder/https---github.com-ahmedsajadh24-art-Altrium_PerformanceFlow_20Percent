# Generate a long random value before deployment.
PERFORMANCEFLOW_SECRET_KEY=replace-with-a-long-random-secret

# Set to 1 only when the application is served over HTTPS.
PERFORMANCEFLOW_SECURE_COOKIES=0

# Keep disabled outside local development.
PERFORMANCEFLOW_DEBUG=0

# Optional bootstrap passwords used only when init_db.py creates accounts.
PERFORMANCEFLOW_HR_PASSWORD=replace-with-a-unique-password
PERFORMANCEFLOW_SUPERVISOR_PASSWORD=replace-with-a-unique-password
PERFORMANCEFLOW_MANAGER_PASSWORD=replace-with-a-unique-password
